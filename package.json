{
  "name": "ludu-vuejs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "levels": "node --import tsx scripts/generate-levels.ts",
    "native:sync": "npm run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "assets": "capacitor-assets generate --ios --android --assetPath assets/launch --logoSplashTargetWidth 600 --splashBackgroundColor \"#f5efed\" --splashBackgroundColorDark \"#f5efed\" --iconBackgroundColor \"#fff7e8\" --iconBackgroundColorDark \"#fff7e8\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource/baloo-bhaijaan-2": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
